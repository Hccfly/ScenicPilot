# 复制为 .env 后会由 Settings.from_env() 自动加载；同名系统环境变量优先。
SCENICPILOT_SCENIC_ID=zhuhai-chimelong
SCENICPILOT_DATA_PATH=data/demo/zhuhai_chimelong.jsonl
SCENICPILOT_MIN_RETRIEVAL_SCORE=0.12
SCENICPILOT_TOP_K=8
SCENICPILOT_ANSWER_CONTEXT_LIMIT=3
SCENICPILOT_ANSWER_CONTEXT_TOKEN_BUDGET=2200
SCENICPILOT_ANSWER_MIN_KEYWORD_SCORE=0.08
SCENICPILOT_ANSWER_MIN_SPECIFIC_TERM_MATCHES=1
SCENICPILOT_ANSWER_MIN_SPECIFIC_TERM_COVERAGE=0.5
SCENICPILOT_ANSWER_MIN_AUTHORITY_LEVEL=1
SCENICPILOT_ANSWER_MAX_CLAIM_CHARS=360
# 留空时使用可重复的哈希测试索引；设置后加载已构建的真实本地向量索引。
SCENICPILOT_RETRIEVAL_INDEX_PATH=
SCENICPILOT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
SCENICPILOT_EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
# offline 不访问网络；auto/live 启用 Open-Meteo，并在存在高德 Key 时启用距离服务。
SCENICPILOT_TOOL_MODE=offline
SCENICPILOT_TOOL_TIMEOUT_SECONDS=3
SCENICPILOT_TOOL_MAX_ATTEMPTS=2
SCENICPILOT_TOOL_RETRY_BACKOFF_SECONDS=0.2
SCENICPILOT_TOOL_CACHE_TTL_SECONDS=600
SCENICPILOT_TOOL_STALE_TTL_SECONDS=3600
SCENICPILOT_TOOL_CIRCUIT_BREAKER_THRESHOLD=3
SCENICPILOT_TOOL_CIRCUIT_RESET_SECONDS=30
AMAP_API_KEY=
# offline 保持规则规划；deepseek/openai 仅参与检索候选排序。
SCENICPILOT_LLM_PROVIDER=offline
SCENICPILOT_LLM_BASE_URL=
SCENICPILOT_LLM_MODEL=
SCENICPILOT_LLM_TIMEOUT_SECONDS=20
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Day 7 bounded constraint revision
SCENICPILOT_PLANNING_MAX_REVISIONS=2
SCENICPILOT_PLANNING_DEFAULT_START_TIME=09:30

# Day 8 persistence, HITL and execution governance
SCENICPILOT_CHECKPOINT_DB_PATH=data/runtime/scenicpilot.sqlite3
SCENICPILOT_APPROVAL_MODE=on_request
SCENICPILOT_EXECUTION_TOOL_CALL_LIMIT=24
SCENICPILOT_EXECUTION_RECURSION_LIMIT=40
